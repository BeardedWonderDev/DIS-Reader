<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.dis.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/dis-agent</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>WorkingDirectory</key><string>/Library/Application Support/dis-agent</string>
    <key>StandardOutPath</key><string>/var/log/dis-agent.log</string>
    <key>StandardErrorPath</key><string>/var/log/dis-agent.log</string>
</dict>
</plist>
