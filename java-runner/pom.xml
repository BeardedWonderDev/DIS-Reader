<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.comanagedtechnology</groupId>
  <artifactId>dis-runner</artifactId>
  <version>0.0.4</version>
  <packaging>jar</packaging>

  <dependencies>
    <!-- AS/400 driver you already have -->
    <dependency>
      <groupId>com.ibm</groupId>
      <artifactId>jt400</artifactId>
      <version>21.0.4</version>
    </dependency>

    <!-- HikariCP for pooling -->
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>5.0.1</version>
    </dependency>

    <!-- Jackson for JSON -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.15.0</version>
    </dependency>

    <!-- SLF4J API (HikariCP uses it) -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>1.7.36</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Shade plugin to build one “uber-jar” -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>JDBCRunner</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
           <plugin>
       <artifactId>maven-resources-plugin</artifactId>
       <version>3.2.0</version>
       <executions>
         <execution>
           <id>copy-jar-to-internal</id>
           <phase>package</phase>
           <goals>
             <goal>copy-resources</goal>
           </goals>
           <configuration>
             <outputDirectory>${project.basedir}/../internal</outputDirectory>
             <resources>
               <resource>
                 <directory>${project.build.directory}</directory>
                 <includes>
                   <include>${project.artifactId}-${project.version}.jar</include>
                 </includes>
               </resource>
             </resources>
           </configuration>
         </execution>
       </executions>
     </plugin>
    </plugins>
  </build>
</project>